# ---------------------------------------------------------------
# Key Property Rwanda — single root environment file.
# Copy to .env and adjust. Only VITE_* variables reach the browser.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

APP_NAME=KeyPropertyRwanda
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=key_property_rwanda
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

SESSION_SECRET=bffa632741f35b0ee032b1ce4668585dd4d9a5b46654498fa3df28b1a8bd08effe8cd610d3ac69f736c18ca04911bdb9
SESSION_COOKIE_NAME=keyproperty_session
SESSION_MAX_AGE_HOURS=8
# Set to true when the app is served over HTTPS (production)
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

DEFAULT_TIMEZONE=Africa/Kigali

# Initial Super Admin created by `npm run db:seed` (change the password after first login)
ADMIN_EMAIL=admin@keypropertyrwanda.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Super Admin

# Database used by `npm test` (created and migrated automatically)
TEST_DB_NAME=key_property_rwanda_test

# Public (browser-exposed) variables
VITE_APP_NAME=Key Property Rwanda
